<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wb_license_info_view_list" model="ir.ui.view">
        <field name="name">wb.license.info.list</field>
        <field name="model">wb.license.info</field>
        <field name="arch" type="xml">
            <list create="false"
                  decoration-success="state in ('active', 'trial')"
                  decoration-warning="state == 'grace'"
                  decoration-danger="state in ('expired')"
                  decoration-muted="state == 'unlicensed'"
                  decoration-info="state == 'unknown'">
                <field name="product_code"/>
                <field name="key_masked"/>
                <field name="state"/>
                <field name="valid_to"/>
                <field name="days_remaining"/>
                <field name="max_users"/>
                <field name="last_server_check"/>
                <field name="is_valid"/>
            </list>
        </field>
    </record>

    <record id="wb_license_info_view_form" model="ir.ui.view">
        <field name="name">wb.license.info.form</field>
        <field name="model">wb.license.info</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_open_activate_wizard" type="object"
                            string="Activate License" class="btn-primary"
                            invisible="state != 'unlicensed'"/>
                    <button name="action_open_trial_wizard" type="object"
                            string="Start 7-day free trial"
                            invisible="state != 'unlicensed'"/>
                    <button name="action_force_ping" type="object"
                            string="Check Now"
                            invisible="state == 'unlicensed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="trial,active,grace,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_code" readonly="1"/></h1>
                        <h3><field name="key_masked" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Term">
                            <field name="valid_from" readonly="1"/>
                            <field name="valid_to" readonly="1"/>
                            <field name="grace_until" readonly="1"/>
                            <field name="days_remaining" readonly="1"/>
                            <field name="max_users" readonly="1"/>
                            <field name="instance_status" readonly="1" invisible="not instance_status"/>
                            <field name="instance_until" readonly="1" invisible="not instance_until"/>
                        </group>
                        <group string="Server Sync">
                            <field name="last_server_check" readonly="1"/>
                            <field name="last_check_success" readonly="1"/>
                            <field name="last_error_message" readonly="1"/>
                            <field name="is_valid" readonly="1"/>
                            <field name="effective_min_cache_age_days" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Module Version">
                            <field name="module_technical_name" readonly="1"/>
                            <field name="installed_module_version" readonly="1"/>
                            <field name="latest_module_version" readonly="1"/>
                            <field name="update_available" readonly="1"/>
                            <field name="download_url" widget="url" readonly="1"
                                   invisible="not download_url"/>
                        </group>
                    </group>
                    <group>
                        <field name="user_message" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Raw Server Response" groups="base.group_system">
                        <field name="server_response_raw" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wb_license_info_action" model="ir.actions.act_window">
        <field name="name">WB Licenses</field>
        <field name="res_model">wb.license.info</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No WB licenses configured.</p>
            <p>Install a WB product module, then activate your license or start a
               free trial with the wizard in the settings.</p>
        </field>
    </record>

</odoo>
