msgstr "Die Anfrage konnte nicht übermittelt werden (HTTP %s). Bitte Eingaben prüfen und erneut versuchen."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
msgid "The trial could not be started (HTTP %s). Please try again later or contact support@wissen-beratung.de."
msgstr "Der Test konnte nicht gestartet werden (HTTP %s). Bitte später erneut versuchen oder support@wissen-beratung.de kontaktieren."

#. module: wb_license_client
#: model_terms:ir.ui.view,arch_db:wb_license_client.wb_license_activate_wizard_view_form
msgid ""
"The trial key is issued immediately and bound to this\n"
"                                database. One trial per email address, domain and database.\n"
"                                Afterwards the product needs a license; your data stays."
msgstr "Der Test-Schlüssel wird sofort ausgestellt und an diese Datenbank gebunden. Ein Test je E-Mail-Adresse, Domain und Datenbank. Danach braucht das Produkt eine Lizenz; Ihre Daten bleiben erhalten."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_info.py:0
msgid "This database is not the licensed instance for %(code)s. If it is a test system, neutralize it. After a move, please request the migration (%(support)s)."
msgstr "Diese Datenbank ist nicht die lizenzierte Instanz für %(code)s. Ist sie ein Testsystem, neutralisieren Sie sie. Nach einem Umzug beantragen Sie bitte die Migration (%(support)s)."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
msgid "This license key does not belong to product %s. Please check the product code and the key."
msgstr "Dieser Lizenzschlüssel gehört nicht zum Produkt %s. Bitte Produkt-Code und Schlüssel prüfen."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
msgid "This license key has already been activated on another instance. Do you want to request a migration?"
msgstr "Dieser Lizenzschlüssel wurde bereits an einer anderen Instanz aktiviert. Möchten Sie eine Migration beantragen?"

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
