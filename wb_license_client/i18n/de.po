msgstr "Die Lizenz für %(code)s ist jetzt aktiv. Gültig bis %(until)s.%(suffix)s"

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_info.py:0
msgid "The license for %s has expired. Please contact support@wissen-beratung.de to renew it."
msgstr "Die Lizenz für %s ist abgelaufen. Bitte kontaktieren Sie support@wissen-beratung.de für eine Verlängerung."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/wizards/wb_license_activate_wizard.py:0
msgid "The license key has an invalid format. Expected: WB-XXXX-xxxxxxxxXX (example: WB-TELE-a3f28c919K)"
msgstr "Der Lizenzschlüssel hat ein ungültiges Format. Erwartet: WB-XXXX-xxxxxxxxXX (Beispiel: WB-TELE-a3f28c919K)"

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
msgid "The license key has an invalid format. Please enter it exactly as shown on the certificate."
msgstr "Der Lizenzschlüssel hat ein ungültiges Format. Bitte genau so eingeben, wie er auf dem Zertifikat steht."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
msgid "The license server cannot be reached (HTTP %s). Please try again later or contact vertrieb@wissen-beratung.de."
msgstr "Lizenzserver nicht erreichbar (HTTP %s). Bitte später erneut versuchen oder vertrieb@wissen-beratung.de kontaktieren."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
msgid "The license server cannot be reached. Please check the internet connection and try again. No trial was started."
msgstr "Der Lizenzserver ist nicht erreichbar. Bitte prüfen Sie die Internetverbindung und versuchen Sie es erneut. Es wurde kein Test gestartet."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
msgid "The license server cannot be reached. Please check your internet connection and try again."
msgstr "Der Lizenzserver ist nicht erreichbar. Bitte prüfen Sie Ihre Internetverbindung und versuchen Sie es erneut."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_info.py:0
msgid "The license server cannot be reached. Your license keeps working; if the problem persists, please check the internet connection or contact support@wissen-beratung.de."
msgstr "Der Lizenzserver ist nicht erreichbar. Ihre Lizenz funktioniert weiter; bei anhaltenden Problemen bitte die Internetverbindung prüfen oder support@wissen-beratung.de kontaktieren."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
msgid "The license server does not know this product. Please contact support@wissen-beratung.de."
msgstr "Der Lizenzserver kennt dieses Produkt nicht. Bitte support@wissen-beratung.de kontaktieren."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
msgid "The license server sent an invalid answer. No trial was started. Please contact support@wissen-beratung.de."
msgstr "Der Lizenzserver hat eine ungültige Antwort gesendet. Es wurde kein Test gestartet. Bitte support@wissen-beratung.de kontaktieren."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
msgid "The license server sent an invalid answer. The license was not activated. Please contact support@wissen-beratung.de."
msgstr "Der Lizenzserver hat eine ungültige Antwort gesendet. Die Lizenz wurde nicht aktiviert. Bitte support@wissen-beratung.de kontaktieren."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
msgid "The migration could not be requested (HTTP %s). Please try again later or contact support@wissen-beratung.de."
msgstr "Die Migration konnte nicht beantragt werden (HTTP %s). Bitte später erneut versuchen oder support@wissen-beratung.de kontaktieren."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/wizards/wb_license_activate_wizard.py:0
