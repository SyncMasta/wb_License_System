#. module: wb_license_client
#: model:mail.template,body_html:wb_license_client.mail_template_expired_local
msgid ""
"<div>\n"
"                    <p>Hello,</p>\n"
"                    <p>Your license for <strong t-out=\"object.product_code\"/> has <strong>expired</strong>.</p>\n"
"                    <p>Licensed features are locked until the license is renewed. Existing data stays readable.</p>\n"
"                    <p>To renew it, please contact support@wissen-beratung.de.</p>\n"
"                    <p>Kind regards<br/>WISSEN BERATUNG</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>Hallo,</p>\n"
"                    <p>Ihre Lizenz für <strong t-out=\"object.product_code\"/> ist <strong>abgelaufen</strong>.</p>\n"
"                    <p>Lizenzpflichtige Funktionen sind bis zur Verlängerung gesperrt. Bestehende Daten bleiben lesbar.</p>\n"
"                    <p>Für eine Verlängerung kontaktieren Sie bitte support@wissen-beratung.de.</p>\n"
"                    <p>Viele Grüße<br/>WISSEN BERATUNG</p>\n"
"                </div>\n"
"            "

#. module: wb_license_client
#: model:mail.template,body_html:wb_license_client.mail_template_grace_started_local
msgid ""
"<div>\n"
"                    <p>Hello,</p>\n"
"                    <p>Your license for <strong t-out=\"object.product_code\"/> is in its <strong>grace period</strong> because an invoice is overdue.</p>\n"
"                    <p>Please pay the open invoice by <strong t-out=\"object.grace_until or '-'\"/> to avoid interruptions.</p>\n"
"                    <p>Questions: support@wissen-beratung.de</p>\n"
"                    <p>Kind regards<br/>WISSEN BERATUNG</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p>Hallo,</p>\n"
"                    <p>Ihre Lizenz für <strong t-out=\"object.product_code\"/> befindet sich in der <strong>Kulanzzeit</strong>, weil eine Rechnung überfällig ist.</p>\n"
"                    <p>Bitte begleichen Sie die offene Rechnung bis zum <strong t-out=\"object.grace_until or '-'\"/>, um Unterbrechungen zu vermeiden.</p>\n"
"                    <p>Bei Fragen: support@wissen-beratung.de</p>\n"
"                    <p>Viele Grüße<br/>WISSEN BERATUNG</p>\n"
"                </div>\n"
"            "

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/wizards/wb_license_activate_wizard.py:0
msgid "<p><strong>How to activate your license:</strong></p><ol><li>Enter the license key (from the certificate)</li><li>Click the ticket link in the activation email</li><li>Enter the 6-digit confirmation code (email)</li><li>Copy the 25-character activation code from the portal and paste it below</li></ol>"
msgstr "<p><strong>So aktivieren Sie Ihre Lizenz:</strong></p><ol><li>Geben Sie den Lizenzschlüssel ein (vom Zertifikat)</li><li>Klicken Sie auf den Ticket-Link aus der Aktivierungs-E-Mail</li><li>Geben Sie den 6-stelligen Bestätigungs-Code ein (E-Mail)</li><li>Kopieren Sie den 25-stelligen Aktivierungs-Code vom Portal und fügen Sie ihn unten ein</li></ol>"

#. module: wb_license_client
#: model_terms:ir.ui.view,arch_db:wb_license_client.wb_license_activate_wizard_view_form
msgid ""
"<strong>Important:</strong> Once the license is activated, a later\n"
"                                <strong>credit note or refund of the purchase price is\n"
"                                excluded</strong> (§ 6.5 EULA).\n"
"                                This confirmation is recorded by WISSEN BERATUNG as evidence."
msgstr "<strong>Wichtig:</strong> Mit der Aktivierung der Lizenz ist eine spätere <strong>Gutschrift bzw. Erstattung des Kaufpreises ausgeschlossen</strong> (§ 6.5 EULA). Diese Bestätigung wird zu Beweiszwecken bei WISSEN BERATUNG protokolliert."

#. module: wb_license_client
#: model_terms:ir.ui.view,arch_db:wb_license_client.wb_license_migrate_wizard_view_form
msgid ""
"<strong>Note:</strong> A migration is possible once a year and has to be\n"
"                           approved by WISSEN BERATUNG (usually 1-2 working days)."
msgstr "<strong>Hinweis:</strong> Eine Migration ist 1x pro Jahr möglich und muss von WISSEN BERATUNG freigegeben werden (normalerweise 1-2 Werktage)."

#. module: wb_license_client
#: model_terms:ir.ui.view,arch_db:wb_license_client.wb_license_activate_wizard_view_form
