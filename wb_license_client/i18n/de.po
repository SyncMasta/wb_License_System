msgstr "Zeitpunkt der letzten fehlgeschlagenen Prüfung. Erneut geprüft wird frühestens nach 15 Minuten; bis dahin gilt der gespeicherte Zustand."

#. module: wb_license_client
#: model:ir.model.fields,help:wb_license_client.field_wb_license_info__last_install_announce_at
msgid "Time of the last install announcement to the license server (at most once a day)."
msgstr "Zeitpunkt der letzten Install-Meldung an den Lizenzserver (höchstens einmal am Tag)."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
msgid "Too many failed attempts. Please wait one hour and try again."
msgstr "Zu viele Fehlversuche. Bitte warten Sie eine Stunde und versuchen Sie es erneut."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_client.py:0
