msgstr "Domain oder DB-UUID dieser Odoo-Instanz konnte nicht ermittelt werden. Bitte informieren Sie Ihren System-Administrator."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/models/wb_license_info.py:0
msgid "The evaluation period of %(code)s on this test system has expired. This database needs a DEV license (%(support)s)."
msgstr "Die Probezeit für %(code)s auf diesem Testsystem ist abgelaufen. Für diese Datenbank brauchen Sie eine DEV-Lizenz (%(support)s)."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/wizards/wb_license_activate_wizard.py:0
msgid "The free trial of %(code)s is active until %(until)s."
msgstr "Der kostenlose Test von %(code)s läuft bis %(until)s."

#. module: wb_license_client
#. odoo-python
#: code:addons/wb_license_client/wizards/wb_license_activate_wizard.py:0
