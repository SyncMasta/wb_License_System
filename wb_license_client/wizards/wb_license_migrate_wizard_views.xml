<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wb_license_migrate_wizard_view_form" model="ir.ui.view">
        <field name="name">wb.license.migrate.wizard.form</field>
        <field name="model">wb.license.migrate.wizard</field>
        <field name="arch" type="xml">
            <form string="Request License Migration">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <p><strong>Note:</strong> A migration is possible once a year and has to be
                           approved by WISSEN BERATUNG (usually 1-2 working days).</p>
                        <p>Please open this wizard on the <strong>new</strong> Odoo instance; the current
                           domain and database ID are read automatically.</p>
                    </div>
                    <group>
                        <field name="product_code"/>
                        <field name="new_domain"/>
                        <field name="new_db_uuid" readonly="1"/>
                        <field name="contact_email"/>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1"
                               placeholder="Why the move? E.g. 'new hosting provider', 'company reorganization'..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_request_migration" type="object"
                            string="Request Migration" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wb_license_migrate_wizard_action" model="ir.actions.act_window">
        <field name="name">Request Migration</field>
        <field name="res_model">wb.license.migrate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
