<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_grace_started_local" model="mail.template">
            <field name="name">WB License Client: Grace Period Started</field>
            <field name="model_id" ref="model_wb_license_info"/>
            <field name="subject">[WISSEN BERATUNG] License warning: {{ object.product_code }}</field>
            <field name="email_from">{{ user.company_id.email or '' }}</field>
            <field name="email_to">{{ user.company_id.email or user.email or '' }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello,</p>
                    <p>Your license for <strong t-out="object.product_code"/> is in its <strong>grace period</strong> because an invoice is overdue.</p>
                    <p>Please pay the open invoice by <strong t-out="object.grace_until or '-'"/> to avoid interruptions.</p>
                    <p>Questions: support@wissen-beratung.de</p>
                    <p>Kind regards<br/>WISSEN BERATUNG</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_expired_local" model="mail.template">
            <field name="name">WB License Client: License Expired</field>
            <field name="model_id" ref="model_wb_license_info"/>
            <field name="subject">[WISSEN BERATUNG] License expired: {{ object.product_code }}</field>
            <field name="email_from">{{ user.company_id.email or '' }}</field>
            <field name="email_to">{{ user.company_id.email or user.email or '' }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello,</p>
                    <p>Your license for <strong t-out="object.product_code"/> has <strong>expired</strong>.</p>
                    <p>Licensed features are locked until the license is renewed. Existing data stays readable.</p>
                    <p>To renew it, please contact support@wissen-beratung.de.</p>
                    <p>Kind regards<br/>WISSEN BERATUNG</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
