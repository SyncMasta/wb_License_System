{
    "name": "wissen-beratung/wb-license-client",
    "description": "Client-Seite des WB-Lizenzsystems für PHP-Dienste (Entitlement, kein Kopierschutz).",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "WISSEN BERATUNG (Tobias Wissen)",
            "email": "info@wissen-beratung.de"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.18",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "WissenBeratung\\LicenseClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WissenBeratung\\LicenseClient\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "WissenBeratung\\LicenseClient\\Laravel\\LicenseServiceProvider"
            ]
        }
    },
    "suggest": {
        "illuminate/support": "Nur für die Laravel-Bridge (ServiceProvider und wb:license:ping). Der Kern braucht sie nicht.",
        "guzzlehttp/guzzle": "PSR-18-Client, falls der Dienst noch keinen hat.",
        "nyholm/psr7": "PSR-17-Factories, falls der Dienst noch keine hat."
    },
    "scripts": {
        "test": "pest",
        "test:offline": "@php tests/standalone/run.php",
        "test:interop": "@php tests/interop/verify_vectors.php",
        "analyse": "phpstan analyse",
        "format": "pint"
    }
}
