<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_wb_subscription" model="ir.module.category">
            <field name="name">WISSEN BERATUNG Lizenz-Plattform</field>
            <field name="description">Zugriff auf Lizenz-Verwaltung, Abo-Management und zugehörige Dokumente.</field>
            <field name="sequence">50</field>
        </record>

        <record id="group_wb_subscription_user" model="res.groups">
            <field name="name">Benutzer</field>
            <field name="category_id" ref="module_category_wb_subscription"/>
            <field name="comment">Darf Lizenzen und Events lesen, Trial-Anfragen bearbeiten. Keine Änderungen an Keys.</field>
        </record>

        <record id="group_wb_subscription_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_wb_subscription"/>
            <field name="implied_ids" eval="[(4, ref('group_wb_subscription_user'))]"/>
            <field name="comment">Vollzugriff auf Lizenz-Plattform inkl. Manueller Revoke, Reactivate, Fernet-Key-Verwaltung.</field>
        </record>

        <record id="wb_license_key_company_rule" model="ir.rule">
            <field name="name">wb.license.key: Multi-Company</field>
            <field name="model_id" ref="model_wb_license_key"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="wb_license_event_company_rule" model="ir.rule">
            <field name="name">wb.license.event: Multi-Company</field>
            <field name="model_id" ref="model_wb_license_event"/>
            <field name="domain_force">['|', ('license_id.company_id', 'in', company_ids), ('license_id', '=', False)]</field>
        </record>

    </data>
</odoo>
