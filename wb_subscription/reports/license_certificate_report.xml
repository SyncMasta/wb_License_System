<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_wb_certificate" model="report.paperformat">
        <field name="name">WB Lizenzzertifikat A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">20</field>
        <field name="margin_right">20</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_license_certificate" model="ir.actions.report">
        <field name="name">Lizenzzertifikat</field>
        <field name="model">wb.license.key</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">wb_subscription.report_license_certificate_document</field>
        <field name="report_file">wb_subscription.report_license_certificate_document</field>
        <field name="paperformat_id" ref="paperformat_wb_certificate"/>
        <field name="print_report_name">(object.certificate_number or 'Zertifikat_' + object.name)</field>
        <field name="binding_model_id" ref="model_wb_license_key"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
