<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wb_license_trial_view_list" model="ir.ui.view">
        <field name="name">wb.license.trial.request.list</field>
        <field name="model">wb.license.trial.request</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'converted'"
                  decoration-warning="state == 'pending'"
                  decoration-muted="state in ('expired', 'rejected')">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="company_name"/>
                <field name="contact_email"/>
                <field name="product_id"/>
                <field name="domain"/>
                <field name="company_size"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="wb_license_trial_view_form" model="ir.ui.view">
        <field name="name">wb.license.trial.request.form</field>
        <field name="model">wb.license.trial.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve_and_create_trial" type="object"
                            string="Trial aktivieren" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,active,converted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Kontakt">
                            <field name="contact_name"/>
                            <field name="contact_email"/>
                            <field name="contact_phone"/>
                        </group>
                        <group string="Firma">
                            <field name="company_name"/>
                            <field name="company_size"/>
                            <field name="industry"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="domain"/>
                        </group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="license_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Geplanter Einsatz">
                        <field name="expected_use_case" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="wb_license_trial_action" model="ir.actions.act_window">
        <field name="name">Trial-Anfragen</field>
        <field name="res_model">wb.license.trial.request</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
