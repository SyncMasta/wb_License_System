<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wb_license_key_view_list" model="ir.ui.view">
        <field name="name">wb.license.key.list</field>
        <field name="model">wb.license.key</field>
        <field name="arch" type="xml">
            <list string="Lizenzen" decoration-success="state == 'active'"
                  decoration-warning="state == 'grace'"
                  decoration-danger="state in ('expired', 'revoked')"
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'trial'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="bound_domain"/>
                <field name="activated_at"/>
                <field name="last_seen_at"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="wb_license_key_view_form" model="ir.ui.view">
        <field name="name">wb.license.key.form</field>
        <field name="model">wb.license.key</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_revoke" string="Sperren" type="object"
                            invisible="state in ('revoked', 'expired', 'cancelled')"
                            confirm="Lizenz wirklich sperren? Der Kunde verliert sofort Zugriff."/>
                    <button name="action_reactivate" string="Reaktivieren" type="object"
                            invisible="state not in ('revoked', 'expired')"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="issued,trial,active,grace,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Lizenzschlüssel"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Beziehungen">
                            <field name="product_id"/>
                            <field name="product_code"/>
                            <field name="partner_id"/>
                            <field name="subscription_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Laufzeit">
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="grace_until" readonly="1"/>
                            <field name="last_renewal_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Aktivierung">
                            <field name="activated_at" readonly="1"/>
                            <field name="activation_expires_at" readonly="1"/>
                            <field name="activated_fingerprint" readonly="1"
                                   groups="wb_subscription.group_wb_subscription_manager"/>
                        </group>
                        <group string="Instanz-Bindung">
                            <field name="bound_domain" readonly="1"/>
                            <field name="bound_db_uuid" readonly="1"
                                   groups="wb_subscription.group_wb_subscription_manager"/>
                            <field name="instance_limit"/>
                            <field name="instance_current" readonly="1"/>
                        </group>
                    </group>
                    <group string="Monitoring">
                        <group>
                            <field name="last_seen_at" readonly="1"/>
                            <field name="ping_count_total" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_seen_ip" readonly="1"
                                   groups="wb_subscription.group_wb_subscription_manager"/>
                            <field name="last_seen_user_agent" readonly="1"
                                   groups="wb_subscription.group_wb_subscription_manager"/>
                        </group>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags"
                               options="{'color_field': 'color'}"/>
                    </group>
                    <notebook>
                        <page string="Events" name="events">
                            <field name="event_ids" readonly="1">
                                <list>
                                    <field name="timestamp"/>
                                    <field name="event_type"/>
                                    <field name="ip_address"/>
                                    <field name="domain"/>
                                    <field name="created_by_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tickets" name="tickets">
                            <field name="ticket_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="email"/>
                                    <field name="otp_sent_at"/>
                                    <field name="expires_at"/>
                                </list>
                            </field>
                        </page>
                        <page string="Migrationen" name="migrations">
                            <field name="migration_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="new_domain"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notizen" name="notes">
                            <group>
                                <field name="note" nolabel="1" placeholder="Kunden-sichtbare Notiz..."/>
                                <field name="internal_note" nolabel="1"
                                       placeholder="Interne Notiz (nur Manager)..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="wb_license_key_view_search" model="ir.ui.view">
        <field name="name">wb.license.key.search</field>
        <field name="model">wb.license.key</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="bound_domain"/>
                <field name="tag_ids"/>
                <filter name="active" string="Aktiv" domain="[('state', '=', 'active')]"/>
                <filter name="trial" string="Trial" domain="[('state', '=', 'trial')]"/>
                <filter name="issued" string="Issued (nicht aktiviert)" domain="[('state', '=', 'issued')]"/>
                <filter name="grace" string="Grace" domain="[('state', '=', 'grace')]"/>
                <filter name="expired" string="Expired" domain="[('state', 'in', ['expired', 'cancelled'])]"/>
                <filter name="revoked" string="Revoked" domain="[('state', '=', 'revoked')]"/>
                <separator/>
                <filter name="expiring_soon" string="Läuft in 30 Tagen ab"
                        domain="[('valid_to', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')),
                                 ('state', 'in', ['active', 'grace'])]"/>
                <group expand="0" string="Gruppieren nach">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_product" string="Produkt" context="{'group_by': 'product_id'}"/>
                    <filter name="group_partner" string="Kunde" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="wb_license_key_action" model="ir.actions.act_window">
        <field name="name">Lizenzen</field>
        <field name="res_model">wb.license.key</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="wb_license_key_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Noch keine Lizenzen.</p>
            <p>Neue Lizenzen entstehen automatisch bei Zahlung (Payment-Hook) oder als Trial via Webseite.</p>
        </field>
    </record>

</odoo>
