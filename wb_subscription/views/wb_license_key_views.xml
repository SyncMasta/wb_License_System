<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wb_license_key_view_list" model="ir.ui.view">
        <field name="name">wb.license.key.list</field>
        <field name="model">wb.license.key</field>
        <field name="arch" type="xml">
            <list string="Lizenzen" decoration-success="state == 'active'"
                  decoration-warning="state == 'grace'"
                  decoration-danger="state in ('expired', 'revoked')"
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'trial'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="bound_domain"/>
                <field name="activated_at"/>
                <field name="last_seen_at"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="wb_license_key_view_form" model="ir.ui.view">
        <field name="name">wb.license.key.form</field>
        <field name="model">wb.license.key</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_certificate_pdf" string="Zertifikat erzeugen"
                            type="object" class="btn-primary"
                            invisible="state in ('revoked', 'cancelled')"/>
                    <button name="action_revoke" string="Sperren" type="object"
                            invisible="state in ('revoked', 'expired', 'cancelled')"
                            confirm="Lizenz wirklich sperren? Der Kunde verliert sofort Zugriff."/>
                    <button name="action_reactivate" string="Reaktivieren" type="object"
                            invisible="state not in ('revoked', 'expired')"
                            class="btn-secondary"/>
                    <button name="action_arm_auto_bind" string="Auto-Bind aktivieren"
                            type="object" class="btn-secondary"
                            invisible="auto_bind_armed or state in ('revoked', 'cancelled', 'expired') or activated_at"
                            confirm="Auto-Bind fuer 24h aktivieren? Die naechste Lookup-Anfrage mit passender Domain/Email wird die Lizenz automatisch binden."/>
                    <button name="action_disarm_auto_bind" string="Auto-Bind zuruecksetzen"
                            type="object" class="btn-secondary"
                            invisible="not auto_bind_armed"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="issued,trial,active,grace,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Lizenzschlüssel"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Beziehungen">
                            <field name="product_id"/>
                            <field name="product_code"/>
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Laufzeit">
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="grace_until" readonly="1"/>
                            <field name="last_renewal_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Aktivierung">
                            <field name="activated_at" readonly="1"/>
                            <field name="activation_expires_at" readonly="1"/>
                            <field name="activated_fingerprint" readonly="1"
                                   groups="wb_subscription.group_wb_subscription_manager"/>
                        </group>
                        <group string="Instanz-Bindung">
                            <field name="bound_domain" readonly="1"/>
                            <field name="bound_db_uuid" readonly="1"
                                   groups="wb_subscription.group_wb_subscription_manager"/>
                            <field name="instance_limit"/>
                            <field name="instance_current" readonly="1"/>
                        </group>
                    </group>
                    <group string="Monitoring">
                        <group>
                            <field name="last_seen_at" readonly="1"/>
                            <field name="ping_count_total" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_seen_ip" readonly="1"
                                   groups="wb_subscription.group_wb_subscription_manager"/>
                            <field name="last_seen_user_agent" readonly="1"
                                   groups="wb_subscription.group_wb_subscription_manager"/>
                        </group>
                    </group>
                    <group string="Auto-Bind (Zero-Touch-Aktivierung)" name="auto_bind">
                        <group>
                            <field name="pre_assigned_domain"
                                   placeholder="https://kunde.odoo.com"
                                   readonly="auto_bind_armed or activated_at"/>
                            <field name="pre_assigned_email"
                                   placeholder="kunde@example.com"
                                   readonly="auto_bind_armed or activated_at"/>
                        </group>
                        <group>
                            <field name="auto_bind_armed" readonly="1"/>
                            <field name="auto_bind_armed_until" readonly="1"
                                   invisible="not auto_bind_armed"/>
                            <field name="auto_bind_armed_at" readonly="1"
                                   invisible="not auto_bind_armed_at"/>
                            <field name="auto_bind_armed_by" readonly="1"
                                   invisible="not auto_bind_armed_by"/>
                            <field name="auto_bind_resolved_at" readonly="1"
                                   invisible="not auto_bind_resolved_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags"
                               options="{'color_field': 'color'}"/>
                    </group>
                    <notebook>
                        <page string="Events" name="events">
                            <field name="event_ids" readonly="1">
                                <list>
                                    <field name="timestamp"/>
                                    <field name="event_type"/>
                                    <field name="ip_address"/>
                                    <field name="domain"/>
                                    <field name="created_by_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tickets" name="tickets">
                            <field name="ticket_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="email"/>
                                    <field name="otp_sent_at"/>
                                    <field name="expires_at"/>
                                </list>
                            </field>
                        </page>
                        <page string="Migrationen" name="migrations">
                            <field name="migration_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="new_domain"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Zertifikate" name="certificates">
                            <group>
                                <field name="certificate_number" readonly="1"/>
                                <field name="issue_date" readonly="1"/>
                                <field name="certificate_count" readonly="1"/>
                            </group>
                            <field name="certificate_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="create_date"/>
                                    <field name="file_size"/>
                                    <field name="create_uid"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notizen" name="notes">
                            <group>
                                <field name="note" nolabel="1" placeholder="Kunden-sichtbare Notiz..."/>
                                <field name="internal_note" nolabel="1"
                                       placeholder="Interne Notiz (nur Manager)..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="wb_license_key_view_search" model="ir.ui.view">
        <field name="name">wb.license.key.search</field>
        <field name="model">wb.license.key</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="bound_domain"/>
                <field name="tag_ids"/>
                <filter name="filter_active" string="Aktiv" domain="[('state', '=', 'active')]"/>
                <filter name="filter_trial" string="Trial" domain="[('state', '=', 'trial')]"/>
                <filter name="filter_issued" string="Issued (nicht aktiviert)" domain="[('state', '=', 'issued')]"/>
                <filter name="filter_grace" string="Grace" domain="[('state', '=', 'grace')]"/>
                <filter name="filter_expired" string="Expired" domain="[('state', 'in', ['expired', 'cancelled'])]"/>
                <filter name="filter_revoked" string="Revoked" domain="[('state', '=', 'revoked')]"/>
                <filter name="filter_expiring_soon" string="Läuft in 30 Tagen ab"
                        domain="[('is_expiring_soon', '=', True)]"/>
                <filter name="filter_auto_bind_armed" string="Auto-Bind aktiv"
                        domain="[('auto_bind_armed', '=', True)]"/>
                <filter name="group_state" string="Gruppen: Status" context="{'group_by': 'state'}"/>
                <filter name="group_product" string="Gruppen: Produkt" context="{'group_by': 'product_id'}"/>
                <filter name="group_partner" string="Gruppen: Kunde" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="wb_license_key_view_kanban" model="ir.ui.view">
        <field name="name">wb.license.key.kanban</field>
        <field name="model">wb.license.key</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="valid_to"/>
                <field name="bound_domain"/>
                <field name="last_seen_at"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="partner_id"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>Produkt: <field name="product_id"/></div>
                                <div t-if="record.bound_domain.raw_value">
                                    Domain: <field name="bound_domain"/>
                                </div>
                                <div>Läuft bis: <field name="valid_to"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="tag_ids" widget="many2many_tags"
                                           options="{'color_field': 'color'}"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span t-if="record.last_seen_at.raw_value"
                                          class="text-muted">
                                        Last ping: <field name="last_seen_at" widget="date"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="wb_license_key_view_pivot" model="ir.ui.view">
        <field name="name">wb.license.key.pivot</field>
        <field name="model">wb.license.key</field>
        <field name="arch" type="xml">
            <pivot string="Lizenzen — Pivot" sample="1">
                <field name="product_id" type="row"/>
                <field name="state" type="col"/>
                <field name="instance_limit" type="measure"/>
                <field name="ping_count_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="wb_license_key_view_graph" model="ir.ui.view">
        <field name="name">wb.license.key.graph</field>
        <field name="model">wb.license.key</field>
        <field name="arch" type="xml">
            <graph string="Lizenzen — Verlauf" type="line" sample="1">
                <field name="create_date" interval="month"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="wb_license_key_action" model="ir.actions.act_window">
        <field name="name">Lizenzen</field>
        <field name="res_model">wb.license.key</field>
        <field name="view_mode">kanban,list,pivot,graph,form</field>
        <field name="search_view_id" ref="wb_license_key_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Noch keine Lizenzen.</p>
            <p>Neue Lizenzen entstehen automatisch bei Zahlung (Payment-Hook) oder als Trial via Webseite.</p>
        </field>
    </record>

</odoo>
