<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wb_license_product_action" model="ir.actions.act_window">
        <field name="name">Lizenz-Produkte</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('wb_is_license_product', '=', True)]</field>
        <field name="context">{'default_wb_is_license_product': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Noch keine Lizenz-Produkte angelegt.</p>
            <p>Lege ein neues Produkt an und aktiviere im Tab "WB Lizenz" das Häkchen
               "Ist Lizenz-Produkt". Vergib einen 4-stelligen technischen Code
               (z.B. <code>TELE</code> für Telnyx).</p>
        </field>
    </record>

    <record id="product_template_form_view_wb_license" model="ir.ui.view">
        <field name="name">product.template.form.wb.license</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="WB Lizenz" name="wb_license">
                    <group>
                        <group>
                            <field name="wb_is_license_product"/>
                            <field name="wb_technical_code"
                                   placeholder="z.B. TELE"
                                   invisible="not wb_is_license_product"
                                   required="wb_is_license_product"/>
                            <field name="wb_module_technical_name"
                                   placeholder="z.B. wb_telnyx_voip"
                                   invisible="not wb_is_license_product"/>
                            <field name="wb_latest_module_version"
                                   placeholder="z.B. 19.0.1.1.0"
                                   invisible="not wb_is_license_product"/>
                        </group>
                        <group invisible="not wb_is_license_product">
                            <field name="wb_instance_limit"/>
                            <field name="wb_extra_instance_price"/>
                            <field name="wb_trial_days"/>
                            <field name="wb_activation_grace_days"/>
                        </group>
                    </group>
                    <group invisible="not wb_is_license_product" string="Templates">
                        <field name="wb_eula_template_id"
                               options="{'no_create': True}"/>
                        <div class="alert alert-warning" role="alert"
                             colspan="2"
                             invisible="not wb_is_license_product or wb_eula_template_id">
                            <strong>Kein EULA-Template gesetzt.</strong>
                            Bei License-Issuance wird kein EULA-PDF erzeugt.
                            Vorschlag: Template auswählen aus
                            <em>Einstellungen → Technisch → E-Mail → E-Mail-Vorlagen</em>
                            (z.B. „WB Lizenz: EULA — Bitwarden for Odoo" für
                            Bitwarden-Produkte).
                        </div>
                        <field name="wb_certificate_template_id"/>
                    </group>
                    <group invisible="not wb_is_license_product" string="Subscription">
                        <field name="wb_default_subscription_plan_id"
                               options="{'no_create': True}"/>
                        <field name="wb_billing_calendar"/>
                    </group>
                    <group invisible="not wb_is_license_product"
                           string="Modul-Releases (Kunden-Portal)">
                        <field name="wb_current_release_id" readonly="1"
                               options="{'no_open': False}"/>
                        <field name="wb_latest_module_version" readonly="1"/>
                        <field name="wb_has_downloadable_tarball" readonly="1"/>
                    </group>
                    <group invisible="not wb_is_license_product"
                           string="Versionen">
                        <field name="wb_release_ids" nolabel="1" colspan="2">
                            <list editable="bottom"
                                  decoration-success="is_current"
                                  decoration-muted="state == 'archived'"
                                  decoration-info="state == 'draft'">
                                <field name="version"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'published'"
                                       decoration-muted="state == 'archived'"
                                       decoration-info="state == 'draft'"/>
                                <field name="is_current" widget="boolean_toggle" readonly="1"/>
                                <field name="released_at"/>
                                <field name="filename"/>
                                <field name="attachment_id"
                                       options="{'no_create': True}"/>
                                <field name="has_attachment" readonly="1"/>
                                <field name="download_count" readonly="1"/>
                                <button name="action_set_current" type="object"
                                        string="→ Current"
                                        invisible="is_current or state == 'archived' or not has_attachment"/>
                            </list>
                        </field>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
