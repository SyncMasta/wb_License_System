<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wb_license_tag_view_list" model="ir.ui.view">
        <field name="name">wb.license.tag.list</field>
        <field name="model">wb.license.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="wb_license_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">wb.license.tag</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
